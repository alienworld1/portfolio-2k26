---
import { workspaceDestinations } from '../../data/overview';
import Icon from '../ui/Icon.astro';
import Pane from '../workspace/Pane.astro';
---

<Pane focusable paneId="index" status="direct routes" title="Workspace index">
  <nav aria-label="Portfolio workspace index">
    <ul class="index-grid bg-outline m-0 grid list-none gap-px p-0">
      {
        workspaceDestinations.map((destination) => (
          <li class="bg-surface-container-lowest">
            <a
              class="text-on-surface visited:text-on-surface hover:bg-primary-container group flex h-full min-h-28 items-start justify-between gap-4 p-4 no-underline"
              href={destination.href}
            >
              <span>
                <span class="text-primary font-interface block text-[0.6875rem] font-semibold">
                  [{destination.coordinate}]
                </span>
                <span class="font-interface mt-2 block text-sm font-bold">
                  {destination.label}
                </span>
                <span class="text-on-surface-variant mt-1 block text-sm leading-snug">
                  {destination.description}
                </span>
              </span>
              <Icon
                class="mt-1 shrink-0 transition-transform group-hover:translate-x-1"
                name="arrowRight"
                size={16}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Pane>

<style>
  .index-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  @container pane (min-width: 28rem) {
    .index-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container pane (min-width: 52rem) {
    .index-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
