---
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import type { IconType } from 'react-icons';
import {
  LuArrowRight,
  LuBriefcaseBusiness,
  LuBuilding2,
  LuChevronLeft,
  LuChevronRight,
  LuExternalLink,
  LuFileText,
  LuFlaskConical,
  LuGithub,
  LuGlobe,
  LuHouse,
  LuMail,
  LuMaximize2,
  LuMenu,
  LuRotateCcw,
  LuSearch,
  LuSlidersHorizontal,
  LuTrophy,
  LuUserRound,
} from 'react-icons/lu';

const icons = {
  arrowRight: LuArrowRight,
  briefcase: LuBriefcaseBusiness,
  building: LuBuilding2,
  chevronLeft: LuChevronLeft,
  chevronRight: LuChevronRight,
  external: LuExternalLink,
  file: LuFileText,
  lab: LuFlaskConical,
  github: LuGithub,
  globe: LuGlobe,
  home: LuHouse,
  mail: LuMail,
  maximize: LuMaximize2,
  menu: LuMenu,
  reset: LuRotateCcw,
  search: LuSearch,
  sliders: LuSlidersHorizontal,
  trophy: LuTrophy,
  user: LuUserRound,
} satisfies Record<string, IconType>;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  ariaLabel?: string;
}

const { name, size = 18, class: className, ariaLabel } = Astro.props;
const iconMarkup = renderToStaticMarkup(
  createElement(icons[name], {
    'aria-hidden': ariaLabel ? undefined : true,
    'aria-label': ariaLabel,
    className,
    focusable: false,
    size,
  }),
);
---

<Fragment set:html={iconMarkup} />
